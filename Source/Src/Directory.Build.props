<Project>
    <!-- 
    Import the next higher level Directory.Build.props file. 
   -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />
    <!-- 
    Define Source-Level properties
   -->
    <PropertyGroup Label="SourceGlobals">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Configurations>Debug;Release;Package</Configurations>
        <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
        <Version>0.0.7</Version>
        <Authors>Kevin Zehrer</Authors>
        <Copyright>Copyright © 2026 Kevin Zehrer. All rights reserved.</Copyright>
        <Product>KZDev PrimeTime</Product>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>Version $(Version). Pre-release package; see the repository for changes and release history.</PackageReleaseNotes>
    </PropertyGroup>
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)'=='Package' OR '$(Target)' == 'Pack' ">
        <IsPacking>true</IsPacking>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(IsPacking)'=='' AND '$(Configuration)'!='Package' ">
        <IsPacking>false</IsPacking>
    </PropertyGroup>
    <PropertyGroup>
        <_PrimeTimeReleaseAggregationProject>$(MSBuildThisFileDirectory)..\Tools\KZDev.PrimeTime.ReleaseAggregation\KZDev.PrimeTime.ReleaseAggregation.csproj</_PrimeTimeReleaseAggregationProject>
        <_PrimeTimeReleaseAggregationDll>$(ArtifactsPath)\bin\KZDev.PrimeTime.ReleaseAggregation\release\KZDev.PrimeTime.ReleaseAggregation.dll</_PrimeTimeReleaseAggregationDll>
        <_PrimeTimeReleaseAggregationBuildConfiguration>Release</_PrimeTimeReleaseAggregationBuildConfiguration>
    </PropertyGroup>
    <UsingTask
        TaskName="KZDev.PrimeTime.ReleaseAggregation.ExtractPackageReleaseNotesTask"
        AssemblyFile="$(_PrimeTimeReleaseAggregationDll)" />
    <ItemGroup>
        <_PrimeTimeReleaseAggregationBuildInputs Include="$(_PrimeTimeReleaseAggregationProject)" />
        <_PrimeTimeReleaseAggregationBuildInputs Include="$(MSBuildThisFileDirectory)..\Tools\KZDev.PrimeTime.ReleaseAggregation\**\*.cs"
            Exclude="$(MSBuildThisFileDirectory)..\Tools\KZDev.PrimeTime.ReleaseAggregation\**\obj\**;$(MSBuildThisFileDirectory)..\Tools\KZDev.PrimeTime.ReleaseAggregation\**\bin\**" />
    </ItemGroup>
    <Target
        Name="_BuildPrimeTimeReleaseAggregation"
        BeforeTargets="DispatchToInnerBuilds"
        Condition="'$(IsCrossTargetingBuild)' == 'true' OR '$(TargetFrameworks)' == ''"
        Inputs="@(_PrimeTimeReleaseAggregationBuildInputs)"
        Outputs="$(_PrimeTimeReleaseAggregationDll)">
        <MSBuild
            Projects="$(_PrimeTimeReleaseAggregationProject)"
            Targets="Build"
            Properties="Configuration=$(_PrimeTimeReleaseAggregationBuildConfiguration)"
            RemoveProperties="TargetFramework;TargetFrameworks" />
        <Error
            Condition="!Exists('$(_PrimeTimeReleaseAggregationDll)')"
            Text="Release aggregation task assembly was not built: '$(_PrimeTimeReleaseAggregationDll)'." />
    </Target>
    <Target Name="GeneratePackageReleaseNotes" BeforeTargets="GenerateNuspec" DependsOnTargets="_BuildPrimeTimeReleaseAggregation">
        <Error Condition="'$(PackageReleaseNotesSourceFile)' == ''" Text="PackageReleaseNotesSourceFile is required for package '$(PackageId)'." />
        <PropertyGroup>
            <_ResolvedPackageReleaseNotesSourceFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PackageReleaseNotesSourceFile)'))</_ResolvedPackageReleaseNotesSourceFile>
        </PropertyGroup>
        <ExtractPackageReleaseNotesTask
            ReleaseNotesFilePath="$(_ResolvedPackageReleaseNotesSourceFile)"
            PackageVersion="$(Version)"
            PackageId="$(PackageId)">
            <Output TaskParameter="PackageReleaseNotes" PropertyName="PackageReleaseNotes" />
        </ExtractPackageReleaseNotesTask>
        <Error Condition="'$(PackageReleaseNotes)' == ''" Text="PackageReleaseNotes was not generated for package '$(PackageId)'." />
    </Target>
</Project>

