<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- DocFX reflects KZDev.PrimeTime.dll from artifacts; copy NodaTime next to it for assembly resolution. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>PrimeTime superset: contracts plus NodaTime clocks (IPrimeClock/PrimeClock) with NodaTime overloads. Prefer KZDev.SystemClock.PrimeTime for a BCL-only subset.</Description>
	</PropertyGroup>
	<PropertyGroup Label="Package">
		<Title>KZDev PrimeTime</Title>
		<PackageId>KZDev.PrimeTime</PackageId>
		<PackageTags>KZDev,Utilities,Time,Timer</PackageTags>
		<PackageReadmeFile>docs\README.md</PackageReadmeFile>
		<PackageIcon>images\icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageDescription>$(Description)</PackageDescription>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<RepositoryUrl>https://github.com/kzdev-net/kzdev.primetime</RepositoryUrl>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsPacking)' == 'true'">
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsPacking)' != 'true'">
		<DefineConstants>$(DefineConstants);NOT_PACKAGING</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="NodaTime" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
		<PackageReference Include="Microsoft.Bcl.TimeProvider" />
		<PackageReference Include="System.Threading.Tasks.Extensions" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\Package\KZDev.PrimeTime.readme.md" Pack="true" Visible="false" PackagePath="docs\README.md" />
		<None Include="..\Package\nuget.icon.png" Pack="true" Visible="false" PackagePath="images\icon.png" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="KZDev.PrimeTime.Testing" />
		<InternalsVisibleTo Include="KZDev.PrimeTime.UnitTests" />
	</ItemGroup>

	<Import Project="..\Shared\KZDev.PrimeTime.Common.Shared\KZDev.PrimeTime.Common.Shared.projitems" Label="Shared" />

</Project>
