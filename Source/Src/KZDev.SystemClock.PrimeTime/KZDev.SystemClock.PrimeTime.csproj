<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>KZDev.SystemClock.PrimeTime</RootNamespace>
		<AssemblyName>KZDev.SystemClock.PrimeTime</AssemblyName>
		<Description>PrimeTime strict BCL subset: shared IPrimeClock/PrimeClock model using TimeProvider only; no NodaTime. Prefer KZDev.PrimeTime for the NodaTime superset.</Description>
		<DefineConstants>$(DefineConstants);SYSTEMCLOCK</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Label="Package">
		<Title>KZDev SystemClock PrimeTime</Title>
		<PackageId>KZDev.SystemClock.PrimeTime</PackageId>
		<PackageTags>KZDev,Utilities,Time,Timer</PackageTags>
		<PackageReadmeFile>docs\README.md</PackageReadmeFile>
		<PackageIcon>images\icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageDescription>$(Description)</PackageDescription>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<RepositoryUrl>https://github.com/kzdev-net/kzdev.primetime</RepositoryUrl>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsPacking)' == 'true'">
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsPacking)' != 'true'">
		<DefineConstants>$(DefineConstants);NOT_PACKAGING</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<Import Project="..\Shared\KZDev.PrimeTime.Common.Shared\KZDev.PrimeTime.Common.Shared.projitems" Label="Shared" />
	<ItemGroup>
		<None Include="..\Package\KZDev.SystemClock.PrimeTime.readme.md" Pack="true" Visible="false" PackagePath="docs\README.md" />
		<None Include="..\Package\nuget.icon.png" Pack="true" Visible="false" PackagePath="images\icon.png" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
		<PackageReference Include="Microsoft.Bcl.TimeProvider" />
		<PackageReference Include="System.Threading.Tasks.Extensions" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KZDev.SystemClock.PrimeTime.Testing" />
		<InternalsVisibleTo Include="KZDev.SystemClock.PrimeTime.UnitTests" />
	</ItemGroup>

</Project>
