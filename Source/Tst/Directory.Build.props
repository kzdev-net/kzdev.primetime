<Project>
    <!--
    Import the next higher level Directory.Build.props file first.
    -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />
    <!--
    Define Test-Level properties (override or set for Tst).
    -->
    <PropertyGroup Label="TestGlobals">
        <Configurations>Debug;Release</Configurations>
        <TargetFrameworks>net10.0;net8.0;net481</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <RootNamespace>KZDev.PrimeTime.Tests</RootNamespace>
    </PropertyGroup>
    <!--
    Assembly-level exclusion works on modern TFMs. net481 does not allow ExcludeFromCodeCoverage on the
    assembly (CS0592); test types under Source/Tst also use [ExcludeFromCodeCoverage] at class scope so
    coverage tools exclude them on every target.
    -->
    <ItemGroup Condition="'$(TargetFramework)' != 'net481'">
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NodaTime.Testing" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' != 'net481'">
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    </ItemGroup>
</Project>
