<Project>
  <!-- 
    Define repository level package version properties
   -->
  <ItemGroup Label="PackageVersions">
      <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
      <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
      <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="NodaTime" Version="3.3.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="10.0.5" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>
</Project>